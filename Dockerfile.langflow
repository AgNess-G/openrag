# syntax=docker/dockerfile:1.4
# Multi-stage build: Copy langflow from official image to UBI9 base

# Stage 1: Official langflow image (source)
FROM docker.io/langflowai/langflow:1.9.5 AS langflow-source

# Stage 2: UBI9 minimal runtime with required libraries
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# Switch to root to install system packages
USER 0

# Install minimal system dependencies needed for Python runtime
# Python 3.12 requires: glibc, libm (math), libpthread, libdl, libutil, librt
RUN microdnf install -y \
    ca-certificates \
    shadow-utils \
    glibc \
    glibc-common \
    libgcc \
    && microdnf clean all

# Copy the entire langflow installation from official image
# This includes Python 3.12, langflow, and all dependencies in /app/.venv
COPY --from=langflow-source /app /app

# Set environment variables to match official langflow image
ENV PATH=/app/.venv/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANGFLOW_HOST=0.0.0.0 \
    LANGFLOW_PORT=7860 \
    LANG=C.UTF-8

# Create additional directories needed for runtime
WORKDIR /app
RUN mkdir -p /app/langflow-data \
    && mkdir -p /app/data/.cache \
    && mkdir -p /app/data/.local \
    && mkdir -p /app/data/.config

# Copy flows (OpenRAG specific)
COPY flows/ /app/flows/

# Copy the entrypoint script
COPY --chmod=755 scripts/langflow-entrypoint.py /usr/local/bin/langflow-entrypoint

# Pre-create writable directories for OpenShift compatibility
RUN mkdir -p /opt/app-root/src/.mem0 \
    && mkdir -p /opt/app-root/src/.cache \
    && mkdir -p /opt/app-root/src/.gunicorn

# Set proper ownership for OpenShift compatibility
# Official langflow image uses uid=1000(user) gid=0(root) with HOME=/app/data
# Use root group (GID 0) with group-write permissions for OpenShift arbitrary UIDs
RUN if ! getent group 1000 >/dev/null; then \
        groupadd --gid 1000 langflow; \
    fi \
    && if ! getent passwd 1000 >/dev/null; then \
        useradd --uid 1000 --gid 0 --home-dir /app/data langflow; \
    fi \
    && chown -R 1000:0 /app /opt/app-root/src/.mem0 /opt/app-root/src/.cache /opt/app-root/src/.gunicorn \
    && chmod -R g+rwX /app /opt/app-root/src/.mem0 /opt/app-root/src/.cache /opt/app-root/src/.gunicorn

# NOTE: Container runs as root initially so entrypoint can fix permissions
# The entrypoint script drops to UID 1000 before executing the main process

EXPOSE 7860

ENTRYPOINT ["langflow-entrypoint"]
CMD ["langflow", "run", "--host", "0.0.0.0", "--port", "7860"]

